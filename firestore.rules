rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function validCode(code) {
      return code is string && code.size() >= 20 && code.size() <= 64
        && code.matches('^[A-Za-z0-9]+$');
    }
    function validDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isMember(code) {
      return signedIn() && validCode(code)
        && exists(/databases/$(database)/documents/households/$(code)/members/$(request.auth.uid));
    }
    function joinOpen(code) {
      return !exists(/databases/$(database)/documents/households/$(code)/meta/config)
        || get(/databases/$(database)/documents/households/$(code)/meta/config).data.locked == false;
    }
    function validToken(t) {
      return t is string && t.size() >= 20 && t.size() <= 64 && t.matches('^[A-Za-z0-9]+$');
    }
    // Einladung muss existieren, gültig sein und im selben Batch gelöscht werden (einmalig).
    function validInvite(code, t) {
      return validToken(t)
        && exists(/databases/$(database)/documents/households/$(code)/invites/$(t))
        && get(/databases/$(database)/documents/households/$(code)/invites/$(t)).data.expiresAt > request.time
        && !existsAfter(/databases/$(database)/documents/households/$(code)/invites/$(t));
    }
    function validMember(d) {
      return d.keys().hasOnly(['device', 'joinedAt', 'invite'])
        && d.keys().hasAll(['device', 'joinedAt'])
        && d.device is string && d.device.size() <= 80
        && d.joinedAt == request.time;
    }

    // IDs von Personen/Autos (frei konfigurierbar in meta/setup)
    function validId(x) {
      return x is string && x.matches('^[a-z0-9]{1,20}$');
    }

    function validSetup(d) {
      return d.keys().hasOnly(['people', 'cars']) && d.keys().hasAll(['people', 'cars'])
        && d.people is list && d.people.size() >= 1 && d.people.size() <= 10
        && d.cars is list && d.cars.size() >= 1 && d.cars.size() <= 10;
    }

    function validBooking(d, id) {
      return d.keys().hasOnly(['date', 'car', 'driver', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['date', 'car', 'driver', 'updatedBy', 'updatedAt'])
        && validDate(d.date)
        && validId(d.car)
        && validId(d.driver)
        && validId(d.updatedBy)
        && d.updatedAt == request.time
        && id == d.date + '_' + d.car;
    }

    // type fehlt bei alten Einträgen (= fuel). Tanken/Laden braucht Menge und Kilometerstand.
    function validEntry(d) {
      return d.keys().hasOnly(['car', 'type', 'date', 'odometer', 'amount', 'cost', 'full', 'note', 'createdBy', 'paidBy', 'createdAt'])
        && d.keys().hasAll(['car', 'date', 'cost', 'note', 'createdBy', 'createdAt'])
        && validId(d.car)
        && d.get('type', 'fuel') in ['fuel', 'service', 'parking', 'toll', 'insurance', 'tax', 'other']
        && validDate(d.date)
        && (!('odometer' in d) || (d.odometer is int && d.odometer >= 0 && d.odometer < 10000000))
        && (!('amount' in d) || (d.amount is number && d.amount > 0 && d.amount < 10000))
        && (d.get('type', 'fuel') != 'fuel' || ('amount' in d && 'odometer' in d))
        && (!('full' in d) || d.full is bool)
        && d.cost is number && d.cost >= 0 && d.cost < 100000
        && d.note is string && d.note.size() <= 300
        && validId(d.createdBy)
        && (!('paidBy' in d) || validId(d.paidBy))
        && d.createdAt == request.time;
    }

    function validReminder(d) {
      return d.keys().hasOnly(['car', 'title', 'due', 'intervalMonths', 'note', 'createdBy', 'createdAt'])
        && d.keys().hasAll(['car', 'title', 'due', 'intervalMonths', 'note', 'createdBy', 'createdAt'])
        && validId(d.car)
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && validDate(d.due)
        && d.intervalMonths is int && d.intervalMonths >= 0 && d.intervalMonths <= 120
        && d.note is string && d.note.size() <= 300
        && validId(d.createdBy);
    }

    // Kein Zugriff auf households selbst – insbesondere kein list.
    match /households/{code} {
      allow read, write: if false;

      // Geräte-Mitgliedschaft: Beitritt nur, wenn der Haushalt offen ist oder mit gültiger Einladung.
      match /members/{uid} {
        allow get: if signedIn() && validCode(code) && (uid == request.auth.uid || isMember(code));
        allow list: if isMember(code);
        allow create: if signedIn() && validCode(code) && uid == request.auth.uid
          && validMember(request.resource.data)
          && (joinOpen(code)
            || ('invite' in request.resource.data && validInvite(code, request.resource.data.invite)));
        allow update: if false;
        allow delete: if isMember(code);
      }

      match /meta/{id} {
        allow get: if isMember(code);
        allow create, update: if isMember(code) && (
          (id == 'config'
            && request.resource.data.keys().hasOnly(['locked'])
            && request.resource.data.locked is bool)
          || (id == 'setup' && validSetup(request.resource.data)));
        allow delete: if false;
      }

      match /invites/{token} {
        allow get, list: if isMember(code);
        allow create: if isMember(code) && validToken(token)
          && request.resource.data.keys().hasOnly(['createdAt', 'expiresAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
        allow update: if false;
        allow delete: if isMember(code)
          || (signedIn() && validCode(code)
            && getAfter(/databases/$(database)/documents/households/$(code)/members/$(request.auth.uid)).data.invite == token);
      }

      match /bookings/{id} {
        allow get, list: if isMember(code);
        allow create, update: if isMember(code)
          && validBooking(request.resource.data, id);
        allow delete: if isMember(code);
      }

      match /reminders/{id} {
        allow get, list: if isMember(code);
        allow create: if isMember(code) && validReminder(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(code) && validReminder(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isMember(code);
      }

      match /entries/{id} {
        allow get, list: if isMember(code);
        allow create: if isMember(code) && validEntry(request.resource.data);
        allow update: if false;
        allow delete: if isMember(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
