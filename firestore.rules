rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function validCode(code) {
      return code is string && code.size() >= 20 && code.size() <= 64
        && code.matches('^[A-Za-z0-9]+$');
    }
    function validDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validPerson(p) {
      return p in ['lukas', 'marie'];
    }

    function validBooking(d, id) {
      return d.keys().hasOnly(['date', 'car', 'driver', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['date', 'car', 'driver', 'updatedBy', 'updatedAt'])
        && validDate(d.date)
        && d.car in ['fiat', 'citroen']
        && validPerson(d.driver)
        && validPerson(d.updatedBy)
        && d.updatedAt == request.time
        && id == d.date + '_' + d.car;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['car', 'date', 'odometer', 'amount', 'cost', 'full', 'note', 'createdBy', 'createdAt'])
        && d.keys().hasAll(['car', 'date', 'odometer', 'amount', 'cost', 'full', 'note', 'createdBy', 'createdAt'])
        && d.car in ['fiat', 'citroen']
        && validDate(d.date)
        && d.odometer is int && d.odometer >= 0 && d.odometer < 10000000
        && d.amount is number && d.amount > 0 && d.amount < 10000
        && d.cost is number && d.cost >= 0 && d.cost < 100000
        && d.full is bool && (d.car == 'citroen' || d.full == false)
        && d.note is string && d.note.size() <= 300
        && validPerson(d.createdBy)
        && d.createdAt == request.time;
    }

    // Kein Zugriff auf households selbst – insbesondere kein list.
    match /households/{code} {
      allow read, write: if false;

      match /bookings/{id} {
        allow get, list: if signedIn() && validCode(code);
        allow create, update: if signedIn() && validCode(code)
          && validBooking(request.resource.data, id);
        allow delete: if signedIn() && validCode(code);
      }

      match /entries/{id} {
        allow get, list: if signedIn() && validCode(code);
        allow create: if signedIn() && validCode(code) && validEntry(request.resource.data);
        allow update: if false;
        allow delete: if signedIn() && validCode(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
